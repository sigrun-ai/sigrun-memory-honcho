{
	"name": "@sigrun/memory-honcho",
	"version": "0.1.2",
	"description": "Honcho persistent-memory extension for sigrun (pi-durable)",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/memory-honcho && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"dependencies": {
		"@honcho-ai/sdk": "2.1.2"
	},
	"peerDependencies": {
		"@earendil-works/chord": "~1.5.0",
		"@earendil-works/pi-ai": "~1.5.0",
		"@earendil-works/pi-durable": "~1.5.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@sigrun/sigrun": "file:../sigrun",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"typebox": "1.3.27"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-memory-honcho.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-memory-honcho/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-memory-honcho#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
